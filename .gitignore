*.o
bin/
.DS_Store
score_regression_out/
__pycache__/
*.pyc
*.log
*.sscore
# ...except the golden baselines, which must be committed.  verify_and_commit.sh
# stages with `git add -A`, which honours the two patterns above, so a newly
# added case's .log/.sscore baseline is silently dropped from the commit and
# score_check.sh then compares it against nothing on every fresh clone.  That is
# how the five bed_* cases went unbaselined.
!score_regression_golden/*.log
!score_regression_golden/*.sscore
dist/
*.o.tmp

# Local working notes, scratch directories, and the development scaffolding
# that produced this tree from plink2 (dead-code detectors, the pruning
# pipeline, release-build helpers, the commit gate).  Useful to a maintainer,
# noise to everyone else, so they stay on disk and out of the release.
docs/
tools/
.venv/

# Verification suites and the example-data generator.  They drive the golden
# data under Tests/ and score_regression_golden/, which do ship -- but the
# scripts themselves are maintainer tooling, kept on disk and out of the
# release.  `make pgs_eval_test` is the self-contained check that remains.
score_check.sh
score_regression.sh
pgs_eval_check.sh
input_matrix.sh
demo_give_best_pgs.sh
example/make_example_data.sh

# Test fixtures and the unit-test binary they feed.  Kept locally; example/ is
# what ships, and it is what the README walks through.
Tests/
score_regression_golden/
adjutant_pgs_eval_test.cc

# Outputs from running the README examples, so following along does not dirty
# the tree.  The inputs (demo.*, weights.txt, ...) are committed.
example/result.*
example/ranked.*
example/harmonised.*
example/resolved.*
